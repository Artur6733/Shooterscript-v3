-- RENDER LOOP
RunService.RenderStepped:Connect(function()
	if not camera then return end

	local showEsp = getEspState()
	local aimOn = getAimState()

	-- 1. AIM BOT LOGIC -> НАВОДИТСЯ НА ГОЛОВУ (HEAD)
	if aimOn then
		local targetHead = getTargetHead(camera)
		if targetHead then
			local currentCF = camera.CFrame
			local targetCF = CFrame.lookAt(currentCF.Position, targetHead.Position)
			camera.CFrame = currentCF:Lerp(targetCF, CONFIG.AIM_SMOOTHNESS)
		end
	end

	-- 2. ESP LOGIC -> TRACER ИДЕТ В ТОРС (HUMANOIDROOTPART)
	local viewport = camera.ViewportSize
	if viewport.X <= 0 or viewport.Y <= 0 then return end
	local screenCenter = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)

	for _, player in Players:GetPlayers() do
		if player == localPlayer then continue end

		local elems = getElements(player)
		local char = player.Character

		if not char or not showEsp then
			hideElements(player)
			continue
		end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart

		if not hum or hum.Health <= 0 or not root then
			hideElements(player)
			continue
		end

		-- Точный расчет верх/низ модели для 2D бокса
		local rootPos = root.Position
		local topWorld = rootPos + Vector3.new(0, 2.8, 0)
		local bottomWorld = rootPos - Vector3.new(0, 3.0, 0)

		local topScreen, topOnScreen = camera:WorldToScreenPoint(topWorld)
		local bottomScreen, bottomOnScreen = camera:WorldToScreenPoint(bottomWorld)

		if not topOnScreen or not bottomOnScreen or topScreen.Z <= 0 then
			hideElements(player)
			continue
		end

		local boxHeight = math.abs(bottomScreen.Y - topScreen.Y)
		local boxWidth = boxHeight * 0.55

		-- 2D точка торса (HumanoidRootPart)
		local rootScreenPos, rootOnScreen = camera:WorldToScreenPoint(rootPos)

		if not rootOnScreen then
			hideElements(player)
			continue
		end

		local torsoPos2D = Vector2.new(rootScreenPos.X, rootScreenPos.Y)

		-- Отрисовка ESP Box
		elems.Box.Size = UDim2.fromOffset(boxWidth, boxHeight)
		elems.Box.Position = UDim2.fromOffset(torsoPos2D.X - (boxWidth / 2), topScreen.Y)
		elems.Box.Visible = true

		-- Отрисовка Tracer строго В ТОРС (HumanoidRootPart)
		local dir = torsoPos2D - screenCenter
		local dist = dir.Magnitude

		elems.Tracer.Position = UDim2.fromOffset(screenCenter.X, screenCenter.Y)
		elems.Tracer.Size = UDim2.fromOffset(dist, CONFIG.LINE_THICKNESS)
		elems.Tracer.Rotation = math.deg(math.atan2(dir.Y, dir.X))
		elems.Tracer.Visible = true
	end
end)
