-- Поиск nearest головы для AimBot
local function getTargetHead(cam: Camera): BasePart?
	local char = localPlayer.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart
	if not root then return nil end

	local nearest: BasePart? = nil
	local minDst = CONFIG.AIM_MAX_DISTANCE

	for _, p in Players:GetPlayers() do
		if p ~= localPlayer and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local head = p.Character:FindFirstChild("Head") :: BasePart
			if hum and hum.Health > 0 and head then
				local dst = (head.Position - root.Position).Magnitude
				if dst < minDst then
					minDst = dst
					nearest = head
				end
			end
		end
	end
	return nearest
end

