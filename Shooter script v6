type PlayerElements = {
	Tracer: Frame,
	Box: Frame,
}

local playerElements: { [Player]: PlayerElements } = {}

local function createPlayerElements(player: Player): PlayerElements
	local line = Instance.new("Frame")
	line.Name = "Tracer_" .. player.UserId
	line.AnchorPoint = Vector2.new(0, 0.5)
	line.BackgroundColor3 = CONFIG.ESP_COLOR
	line.BorderSizePixel = 0
	line.Visible = false
	line.Parent = espContainer

	local box = Instance.new("Frame")
	box.Name = "Box_" .. player.UserId
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Visible = false
	box.Parent = espContainer

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Thickness = 1.5
	boxStroke.Color = CONFIG.ESP_COLOR
	boxStroke.Parent = box

	local elements = { Tracer = line, Box = box }
	playerElements[player] = elements
	return elements
end

local function getElements(player: Player): PlayerElements
	return playerElements[player] or createPlayerElements(player)
end

local function hideElements(player: Player)
	local elems = playerElements[player]
	if elems then
		elems.Tracer.Visible = false
		elems.Box.Visible = false
	end
end

local function removeElements(player: Player)
	local elems = playerElements[player]
	if elems then
		elems.Tracer:Destroy()
		elems.Box:Destroy()
		playerElements[player] = nil
	end
end

